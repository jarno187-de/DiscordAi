# ── Required ────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# ── Optional: instant slash commands ────────────────────────
# Put your server ID here and the /commands show up instantly on that server.
# Leave empty to register globally (can take a while the first time).
GUILD_ID=

# ── AI: main brain (recommended) ────────────────────────────
# Groq is free: sign up at https://console.groq.com → API Keys → Create.
# llama-3.1-8b-instant is small, fast, free and appropriately dumb.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant

# Other free OpenAI-compatible options (just swap the three lines above):
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=<any model ending in :free>
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=<a current gemini flash-lite model>

# ── AI: backup brain ────────────────────────────────────────
# Pollinations.ai works with NO key at all, but only ~1 reply per 45 seconds.
# If you leave AI_API_KEY empty, Brian runs on this alone (+ built-in dumb lines when it's busy).
POLLINATIONS_FALLBACK=true
POLLINATIONS_KEY=

# ── Brian's behaviour ───────────────────────────────────────
# Brian answers every message containing this word (empty = disabled).
TRIGGER_WORD=brian
# Channel IDs (comma separated) where Brian answers EVERY message, no ping needed.
CHAT_CHANNEL_IDS=
# Chance (0-1) that Brian butts into a random conversation uninvited.
INTERJECT_CHANCE=0.02
# Chance (0-1) that Brian reacts to a random message with a weird emoji.
REACT_CHANCE=0.03
